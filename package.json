{
  "name": "cx-cms",
  "version": "0.1.0",
  "private": true,
  "description": "AdonisJS and Ant Design Pro monorepo starter",
  "repository": "https://github.com/chuxinruanjian/cx-cms.git",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/api",
    "apps/admin"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "concurrently -n api,admin -c blue,magenta \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=@cx-cms/api",
    "dev:admin": "npm run dev --workspace=@cx-cms/admin",
    "build": "npm run build:admin && npm run build:api",
    "build:admin": "npm run build --workspace=@cx-cms/admin",
    "build:api": "npm run build --workspace=@cx-cms/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspace=@cx-cms/api && npm run tsc --workspace=@cx-cms/admin",
    "test": "npm run test --workspaces --if-present",
    "app:key": "npm run app:key --workspace=@cx-cms/api",
    "db:migrate": "npm run db:migrate --workspace=@cx-cms/api",
    "db:rollback": "npm run db:rollback --workspace=@cx-cms/api",
    "db:seed": "npm run db:seed --workspace=@cx-cms/api",
    "uploads:cleanup": "npm run uploads:cleanup --workspace=@cx-cms/api"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
