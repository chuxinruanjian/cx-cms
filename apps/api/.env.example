# Node
TZ=Asia/Shanghai
PORT=3333
HOST=localhost
NODE_ENV=development

# App
APP_NAME=cx-cms-api
APP_KEY=
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info

# Session
SESSION_DRIVER=cookie

# Database: change only DB_CONNECTION to select a configured driver
DB_CONNECTION=sqlite
SQLITE_DB_PATH=../../storage/database/app.sqlite3
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=cx_cms

# Shared runtime storage (relative to apps/api, or use absolute paths)
LOG_FILE=../../storage/logs/app.log
UPLOAD_DIR=../../storage/uploads
PAYMENT_CERT_DIR=../../storage/certificates/payment

# Uploads
UPLOAD_DISK=local
UPLOAD_NORMAL_MAX_MB=20
UPLOAD_IMAGE_MAX_MB=20
UPLOAD_VIDEO_MAX_MB=2048
UPLOAD_AUDIO_MAX_MB=200
UPLOAD_DOCUMENT_MAX_MB=100
UPLOAD_ARCHIVE_MAX_MB=2048
UPLOAD_OTHER_MAX_MB=100
UPLOAD_MAX_COUNT=20
UPLOAD_CHUNK_SIZE_MB=5
UPLOAD_CHUNK_CONCURRENCY=3
UPLOAD_MAX_RETRIES=3
UPLOAD_TEMPORARY_TTL_HOURS=24
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_DIRECT_ENABLED=false
UPLOAD_DEDUPLICATE=false
UPLOAD_VIRUS_SCAN_ENABLED=false
UPLOAD_CONTENT_REVIEW_ENABLED=false
UPLOAD_IMAGE_QUALITY=85

# Qiniu Kodo (used only when UPLOAD_DISK=qiniu)
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=https://cdn.example.com
# Select the upload host that matches the bucket region.
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_UPLOAD_TOKEN_TTL_SECONDS=600

# Initial administrator (required only when running npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=超级管理员
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=

# Aliyun SMS (configure the templates for the enabled verification scenarios)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
ALIYUN_SMS_SECURITY_MOBILE_TEMPLATE_CODE=
ALIYUN_SMS_PASSWORD_RESET_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# Comma-separated production origins when the CORS policy is customized
# CORS_ORIGIN=https://admin.example.com
